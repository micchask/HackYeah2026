# Opcjonalne: wszystko ma wartości domyślne. Żeby coś zmienić, skopiuj do .env
#   macOS/Linux: cp .env.example .env
#   Windows:     copy .env.example .env

# --- Baza (PostGIS) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Backend ---
# W docker compose host bazy to "db"; przy uruchamianiu backendu lokalnie: localhost
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
DB_ENABLED=true
DEFAULT_CITY=krakow
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# --- Hot reload ---
# Odpytywanie dysku o zmiany plików (potrzebne na Windows). Na macOS/Linux można dać false.
FILE_POLLING=true
