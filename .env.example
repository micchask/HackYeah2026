# Skopiuj do .env: cp .env.example .env

# --- Baza (PostGIS) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Backend ---
# W docker compose host bazy to "db"; przy uruchamianiu backendu lokalnie: localhost
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
DB_ENABLED=true
DEFAULT_CITY=krakow
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
