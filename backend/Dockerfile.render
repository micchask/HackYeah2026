# Obraz backendu dla Rendera (render.yaml). Kontekst budowania = katalog główny repo,
# żeby w obrazie był snapshot danych z data/seed/ (lokalny docker compose używa ./Dockerfile).
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    DATA_DIR=/data

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY backend/ .
COPY data/seed /data/seed

# Dysk na Renderze jest ulotny: przy każdym starcie rozpakuj snapshot do cache,
# a bazę (trwałą) wypełnij tylko za pierwszym razem. Render podaje port w $PORT.
CMD ["sh", "-c", "python -m app.seed --if-empty && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
